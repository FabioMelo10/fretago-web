<div class="max-w-xl mx-auto px-4 py-6 space-y-4">
  <h1 class="text-xl font-semibold mb-2">Cadastro de motorista</h1>
  <p class="text-sm text-slate-300 mb-4">
    Informe seus dados básicos para receber pedidos de frete em Itajaí e região.
  </p>

  <%= form_with model: @motorista, url: motoristas_path, class: "space-y-4" do |f| %>
    <% if @motorista.errors.any? %>
      <div class="rounded-lg border border-rose-500/60 bg-rose-500/10 px-3 py-2 text-xs text-rose-100">
        <p class="font-semibold mb-1">Não foi possível salvar seu cadastro:</p>
        <ul class="list-disc list-inside space-y-0.5">
          <% @motorista.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-1.5">
      <%= f.label :nome, "Nome completo", class: "block text-xs font-medium text-slate-200" %>
      <%= f.text_field :nome, class: "w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm focus:border-emerald-400 focus:outline-none focus:ring-1 focus:ring-emerald-400" %>
    </div>

    <div class="space-y-1.5">
      <%= f.label :telefone, "Telefone (WhatsApp)", class: "block text-xs font-medium text-slate-200" %>
      <%= f.telephone_field :telefone, class: "w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm focus:border-emerald-400 focus:outline-none focus:ring-1 focus:ring-emerald-400" %>
    </div>

    <div class="space-y-1.5">
      <%= f.label :veiculo, "Veículo (ex: Fiorino, caminhonete)", class: "block text-xs font-medium text-slate-200" %>
      <%= f.text_field :veiculo, class: "w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm focus:border-emerald-400 focus:outline-none focus:ring-1 focus:ring-emerald-400" %>
    </div>

    <div class="space-y-1.5">
      <%= f.label :bairro, "Bairro base", class: "block text-xs font-medium text-slate-200" %>
      <%= f.text_field :bairro, class: "w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm focus:border-emerald-400 focus:outline-none focus:ring-1 focus:ring-emerald-400" %>
    </div>

    <div class="flex items-center justify-between pt-2">
      <%= link_to "Voltar", root_path, class: "text-xs text-slate-300 hover:text-white" %>
      <%= f.submit "Concluir cadastro", class: "inline-flex items-center rounded-xl bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-emerald-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950" %>
    </div>
  <% end %>
</div>

