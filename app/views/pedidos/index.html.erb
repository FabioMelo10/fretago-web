<div class="max-w-xl mx-auto px-4 py-6 space-y-4">
  <div class="flex items-center justify-between mb-2">
    <div>
      <h1 class="text-xl font-semibold">Pedidos de frete abertos</h1>
      <p class="text-xs text-slate-300 mt-1">
        Mostrando apenas pedidos com status "aberto" em Itajaí e região.
      </p>
    </div>
    <%= link_to "Voltar", root_path, class: "text-xs text-slate-300 hover:text-white" %>
  </div>

  <% if @pedidos.any? %>
    <div class="space-y-3">
      <% @pedidos.each do |pedido| %>
        <div class="rounded-xl border border-slate-800 bg-slate-900 px-3 py-3 text-sm space-y-1.5">
          <div class="flex items-center justify-between">
            <p class="font-medium truncate"><%= pedido.item %></p>
            <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-medium text-emerald-300">
              Aberto
            </span>
          </div>
          <p class="text-xs text-slate-300">
            De <span class="font-medium"><%= pedido.endereco_retirada %></span>
            para <span class="font-medium"><%= pedido.endereco_entrega %></span>
          </p>
          <p class="text-[11px] text-slate-400">
            Pedido criado há <%= time_ago_in_words(pedido.created_at) %>.
          </p>
          <div class="pt-1.5 flex justify-end">
            <%= link_to "Ver detalhes", pedido_path(pedido),
                        class: "inline-flex items-center rounded-lg border border-slate-700 px-3 py-1 text-[11px] font-medium text-slate-100 hover:bg-slate-800" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-slate-300">Não há pedidos abertos no momento.</p>
  <% end %>
</div>

