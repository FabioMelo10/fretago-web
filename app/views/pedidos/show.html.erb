<div class="max-w-xl mx-auto px-4 py-6 space-y-5">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-semibold">Detalhes do pedido</h1>
    <%= link_to "Voltar", pedidos_path, class: "text-xs text-slate-300 hover:text-white" %>
  </div>

  <section class="rounded-xl border border-slate-800 bg-slate-900 px-4 py-3 text-sm space-y-2">
    <div class="flex items-center justify-between">
      <p class="font-medium"><%= @pedido.item %></p>
      <span class="rounded-full bg-slate-800 px-2 py-0.5 text-[10px] font-medium text-slate-200">
        Status: <%= @pedido.status.humanize %>
      </span>
    </div>
    <p class="text-xs text-slate-300">
      De <span class="font-medium"><%= @pedido.endereco_retirada %></span>
      para <span class="font-medium"><%= @pedido.endereco_entrega %></span>
    </p>
    <% if @pedido.detalhes.present? %>
      <p class="text-xs text-slate-300">
        <span class="font-medium">Detalhes: </span>
        <%= simple_format h(@pedido.detalhes), class: "inline" %>
      </p>
    <% end %>
    <p class="text-[11px] text-slate-400">
      Pedido criado há <%= time_ago_in_words(@pedido.created_at) %>.
    </p>
  </section>

  <section class="space-y-3">
    <h2 class="text-sm font-semibold">Enviar proposta (motoristas)</h2>
    <p class="text-xs text-slate-300">
      Preencha o valor e uma mensagem curta. O contato completo do cliente só deve ser compartilhado após a aceitação.
    </p>

    <%= form_with model: [@pedido, @proposta], url: pedido_propostas_path(@pedido), class: "space-y-3" do |f| %>
      <% if @proposta.errors.any? %>
        <div class="rounded-lg border border-rose-500/60 bg-rose-500/10 px-3 py-2 text-xs text-rose-100">
          <p class="font-semibold mb-1">Não foi possível enviar a proposta:</p>
          <ul class="list-disc list-inside space-y-0.5">
            <% @proposta.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-1.5">
        <%= f.label :motorista_id, "Motorista", class: "block text-xs font-medium text-slate-200" %>
        <%= f.collection_select :motorista_id, Motorista.ativos.order(:nome), :id, :nome,
                                { prompt: "Selecione seu cadastro" },
                                { class: "w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm focus:border-emerald-400 focus:outline-none focus:ring-1 focus:ring-emerald-400" } %>
      </div>

      <div class="space-y-1.5">
        <%= f.label :valor, "Valor proposto (R$)", class: "block text-xs font-medium text-slate-200" %>
        <%= f.number_field :valor, step: 0.01, min: 0, class: "w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm focus:border-emerald-400 focus:outline-none focus:ring-1 focus:ring-emerald-400" %>
      </div>

      <div class="space-y-1.5">
        <%= f.label :mensagem, "Mensagem para o cliente", class: "block text-xs font-medium text-slate-200" %>
        <%= f.text_area :mensagem, rows: 3, class: "w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm focus:border-emerald-400 focus:outline-none focus:ring-1 focus:ring-emerald-400" %>
      </div>

      <div class="flex justify-end">
        <%= f.submit "Enviar proposta", class: "inline-flex items-center rounded-xl bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-emerald-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950" %>
      </div>
    <% end %>
  </section>

  <section class="space-y-3">
    <h2 class="text-sm font-semibold">Propostas recebidas</h2>
    <% if @propostas.any? %>
      <div class="space-y-2">
        <% @propostas.each do |proposta| %>
          <div class="rounded-xl border border-slate-800 bg-slate-900 px-3 py-2 text-sm space-y-1.5">
            <div class="flex items-center justify-between">
              <p class="font-medium"><%= proposta.motorista.nome %></p>
              <span class="rounded-full px-2 py-0.5 text-[10px] font-medium
                          <%= case proposta.status
                             when "aceita" then "bg-emerald-500/10 text-emerald-300"
                             when "recusada" then "bg-slate-800 text-slate-300"
                             else "bg-sky-500/10 text-sky-300"
                             end %>">
                <%= proposta.status.capitalize %>
              </span>
            </div>
            <p class="text-xs text-slate-200">
              Valor: <span class="font-semibold">R$ <%= number_with_precision(proposta.valor, precision: 2) %></span>
            </p>
            <% if proposta.mensagem.present? %>
              <p class="text-xs text-slate-300">
                <span class="font-medium">Mensagem:</span>
                <%= simple_format h(proposta.mensagem), class: "inline" %>
              </p>
            <% end %>
            <% if @pedido.status == "aberto" && proposta.status == "enviada" %>
              <div class="pt-1 flex justify-end">
                <%= button_to "Aceitar proposta",
                              aceitar_proposta_pedido_path(@pedido, proposta_id: proposta.id),
                              method: :patch,
                              class: "inline-flex items-center rounded-lg bg-emerald-500 px-3 py-1 text-[11px] font-semibold text-slate-950 hover:bg-emerald-400" %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-slate-300">Ainda não há propostas para este pedido.</p>
    <% end %>
  </section>
</div>

