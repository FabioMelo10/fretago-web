<div class="max-w-xl mx-auto px-4 py-6 space-y-4">
  <div class="flex items-center justify-between mb-2">
    <div>
      <h1 class="text-xl font-semibold">Painel do motorista</h1>
      <p class="text-xs text-slate-300 mt-1">
        Olá, <span class="font-semibold text-slate-100"><%= motorista_atual.nome %></span>. Estes são os fretes disponíveis no momento.
      </p>
    </div>
    <%= button_to "Sair", motorista_sessao_path, method: :delete,
                  class: "text-xs text-slate-300 hover:text-white bg-transparent border-0 p-0 cursor-pointer" %>
  </div>

  <% if @pedidos.any? %>
    <div class="space-y-3">
      <% @pedidos.each do |pedido| %>
        <div class="rounded-xl border border-slate-800 bg-slate-900 px-3 py-3 text-sm space-y-1.5">
          <div class="grid grid-cols-1 gap-1 text-xs">
            <p><span class="text-slate-400">Item:</span> <span class="font-medium"><%= pedido.item %></span></p>
            <p><span class="text-slate-400">Origem:</span> <span class="font-medium"><%= pedido.endereco_retirada %></span></p>
            <p><span class="text-slate-400">Destino:</span> <span class="font-medium"><%= pedido.endereco_entrega %></span></p>
          </div>

          <div class="flex items-center justify-between pt-1">
            <span class="rounded-full px-2 py-0.5 text-[10px] font-medium <%= pedido_status_badge_class(pedido.status) %>">
              <%= pedido.status.humanize %>
            </span>
            <p class="text-[11px] text-slate-400">há <%= time_ago_in_words(pedido.created_at) %></p>
          </div>

          <div class="pt-1.5">
            <%= link_to "Ver detalhes e enviar proposta", pedido_path(pedido),
                        class: "inline-flex items-center rounded-lg border border-slate-700 px-3 py-1 text-[11px] font-medium text-slate-100 hover:bg-slate-800" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-slate-300">Não há fretes disponíveis neste momento.</p>
  <% end %>
</div>
