<header class="w-full border-b border-slate-800 bg-slate-950/80 backdrop-blur">
  <div class="max-w-xl mx-auto px-4 py-3 flex items-center justify-between">
    <%= link_to root_path, class: "flex items-center space-x-2" do %>
      <div class="h-8 w-8 rounded-xl bg-emerald-500 flex items-center justify-center font-bold text-slate-950">
        FG
      </div>
      <span class="font-semibold tracking-tight">FretaGo</span>
    <% end %>

    <% if motorista_logado? %>
      <div class="flex items-center gap-3">
        <%= link_to "Painel", motorista_painel_path, class: "text-xs text-emerald-300 hover:text-emerald-200" %>
        <%= button_to "Sair", motorista_sessao_path, method: :delete,
                      class: "text-xs text-slate-300 hover:text-white bg-transparent border-0 p-0 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</header>
