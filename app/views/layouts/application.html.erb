<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Fretago Web" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <% if notice.present? %>
      <div class="fixed inset-x-0 top-0 z-40 flex justify-center px-4 pt-4">
        <div class="max-w-xl w-full rounded-lg bg-emerald-500 text-slate-950 px-4 py-3 text-sm shadow-lg">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="fixed inset-x-0 top-0 z-40 flex justify-center px-4 pt-4">
        <div class="max-w-xl w-full rounded-lg bg-rose-500 text-slate-950 px-4 py-3 text-sm shadow-lg">
          <%= alert %>
        </div>
      </div>
    <% end %>

    <main class="min-h-screen bg-slate-950 text-white">
      <%= yield %>
    </main>

    <% unless controller_name == "home" && action_name == "index" %>
      <%= link_to fregato_whatsapp_link,
                  target: "_blank",
                  rel: "noopener noreferrer",
                  class: "sm:hidden fixed bottom-5 right-4 z-30 h-14 w-14 rounded-full bg-[#25D366] text-slate-950 flex items-center justify-center text-2xl shadow-lg shadow-black/40 hover:scale-105 transition-transform",
                  aria: { label: "Falar no WhatsApp" } do %>
        <span aria-hidden="true">💬</span>
      <% end %>
    <% end %>
  </body>
</html>
